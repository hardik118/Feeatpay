generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id String @id @default(uuid())
  email String @unique
  phoneNo String @unique
  Username String @unique
  password  String
  KycStatus KycStatus  @default(Pending)
  createdAt DateTime @default(now())
  
  userKycVerification userKycVerification?
  wallet userWallet? 
}

model userKycVerification{
  userId String @id 
  documentType String
  documentId String
   selfieUrl String
   status KycStatus @default(Pending)
   createdAt  DateTime @default(now())

   user user @relation(references: [id] , fields: [userId])

}
model userWallet{
  walletId String @id @default(uuid())
  userId String
  walletAddress String @unique
  createdAt DateTime @default(now())

  user user  @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

enum KycStatus{
  Pending
  Verified
  Rejected
} 
